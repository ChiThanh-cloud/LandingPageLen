{
  "name": "lentiny-next-migration",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "npm run blog:generate",
    "dev": "next dev",
    "test": "node --import tsx --test \"**/*.test.ts\"",
    "lint": "eslint .",
    "prebuild": "npm run blog:generate",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "blog:generate": "tsx scripts/generate-blog-registry.ts",
    "blog:audit": "tsx scripts/audit-blog-migration.ts",
    "blog:baseline": "tsx scripts/audit-blog-migration.ts --write-baseline",
    "cloudinary:blog-assets": "tsx scripts/cloudinary-blog-assets.ts",
    "cloudinary:blog-rollback": "tsx scripts/cloudinary-blog-rollback.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "16.2.12",
    "@payos/node": "^2.0.5",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "gray-matter": "^4.0.3",
    "next": "16.2.12",
    "qrcode": "^1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/node": "26.1.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "playwright": "^1.62.1",
    "tsx": "^4.23.0",
    "typescript": "5.9.3"
  }
